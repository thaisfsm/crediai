# Desenvolvimento local sem banco; configure URLs do PostgreSQL gerenciado para habilitar autenticação e persistência.
BETTER_AUTH_SECRET=local-only-change-this-to-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL gerenciado: URL de runtime para a aplicação (sem privilégios de BYPASSRLS).
# Deixe vazio para abrir a tela de configuração local sem tentar conectar ao banco.
DATABASE_URL=
# URL de migração com permissões DDL, no mesmo cluster gerenciado. Nunca use no runtime web.
DATABASE_MIGRATION_URL=

# Bootstrap explícito do primeiro SUPER_ADMIN: configure temporariamente antes de `pnpm admin:create`.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
